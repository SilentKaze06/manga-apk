# ==============================================================================
# Manga & PDF OCR Translation Server Environment Template
# Copy this file to .env and adjust your configuration values.
# ==============================================================================

# Server Security & API Key
MANGA_SERVER_API_KEY=your_secret_api_key_here
MANGA_ALLOW_UNAUTHENTICATED=false

# PDF Translation Jobs
MANGA_PDF_ENABLED=true
MANGA_PDF_JOB_DIR=./pdf_job_data
MANGA_MAX_PDF_UPLOAD_BYTES=52428800
MANGA_MAX_PDF_PAGES=500
MANGA_PDF_OCR_DPI=180
MANGA_PDF_OCR_MAX_PIXELS=16777216

# AI Translation Engine Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FILE=
DEEPL_API_KEY=

# OCR & Model Settings
MANGA_USE_HEAVY_MODELS=true
MANGA_DISABLE_PADDLE=false
MANGA_USE_FP16=0
MANGA_USE_MYMEMORY_FALLBACK=true
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
